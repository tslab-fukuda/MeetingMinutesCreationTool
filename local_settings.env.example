# Copy this file to local_settings.env and fill in local secrets.
# local_settings.env is ignored by Git.

# OpenAI / ChatGPT API
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Local OpenAI-compatible LLM API
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=openai/gpt-oss-120b
LOCAL_TRANSCRIBE_MODEL=openai/gpt-oss-120b
LOCAL_LLM_API_KEY=

# Alias names are also supported for local LLM settings:
# BASE_URL=http://127.0.0.1:8000/v1
# MODEL=openai/gpt-oss-120b
# API_KEY=your_local_api_key_here

# Local faster-whisper transcription model (audio -> text).
# tiny is fast but very inaccurate for Japanese; small is a good CPU balance.
# Options: tiny, base, small, medium, large-v3
LOCAL_WHISPER_MODEL=small
# CPU default. With an NVIDIA GPU use: LOCAL_WHISPER_DEVICE=cuda and
# LOCAL_WHISPER_COMPUTE_TYPE=float16
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8

# Default selected provider: openai or local
LLM_PROVIDER=openai

# Optional: force the web app to edit a specific daily minutes file.
# Format: YYYYMMDD. Leave blank to use today's date.
MEETING_MINUTES_DATE=
